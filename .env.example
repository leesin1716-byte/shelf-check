# YouCam API key from https://yce.perfectcorp.com/api-console/en/api-keys/
# Leave empty to run in fixture mode (demo personas, no units spent).
YOUCAM_API_KEY=
# Optional: override the API host (default https://yce-api-01.makeupar.com).
YOUCAM_BASE_URL=
# Live selfie scans are refused when the unit balance falls below this reserve.
YOUCAM_UNIT_RESERVE=300

# Optional: run the shopping agent live with Claude. Without it, demo scenarios
# replay recorded agent runs and custom scans use the deterministic offline planner.
ANTHROPIC_API_KEY=
